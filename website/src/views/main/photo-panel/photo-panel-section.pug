.relative.inline-block
  // Blob Background & Photo Container
  .overflow-hidden.relative.z-10.mx-auto(
    class='w-[400px] h-[400px] bg-[#DED3C7] rounded-[55%_45%_40%_60%/60%_40%_60%_40%]'
  )
    img.w-full.h-full.object-cover(src=require('../../../assets/img/logo.svg'), alt='Photo')

  // Orbital Lines and Stars (SVG)
  svg.absolute.transform.pointer-events-none.z-20(
    class='top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[480px] h-[480px]',
    viewBox='0 0 480 480',
    fill='none',
    xmlns='http://www.w3.org/2000/svg'
  )
    // Ellipse
    ellipse(
      cx='240',
      cy='240',
      rx='220',
      ry='160',
      stroke='#7D6755',
      stroke-width='1',
      transform='rotate(-20 240 240)'
    )

    // Star 1 (Top Left-ish)
    path(
      d='M 80 110 Q 80 120 90 120 Q 80 120 80 130 Q 80 120 70 120 Q 80 120 80 110 Z',
      fill='#7D6755'
    )

    // Star 2 (Bottom Right-ish)
    path(
      d='M 400 350 Q 400 360 410 360 Q 400 360 400 370 Q 400 360 390 360 Q 400 360 400 350 Z',
      fill='#7D6755'
    )
