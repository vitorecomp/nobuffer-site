.relative.inline-block
  // Blob Background & Photo Container
  .overflow-hidden.relative.z-10.mx-auto(
    class='w-[min(400px,80vw)] h-[min(400px,80vw)] sm:w-[500px] sm:h-[500px] bg-[#DED3C7] rounded-[55%_45%_40%_60%/60%_40%_60%_40%]'
  )
    img.w-full.h-full.object-cover(
      class='object-[50%_30%] scale-100 origin-[100%_0%]',
      src=require('../../../assets/img/profile_picture.webp'),
      alt='Vitor — software developer',
      width='1000',
      height='1000',
      fetchpriority='high',
      decoding='async'
    )

  // Orbit — back half, sits behind the photo so cubes pass behind it
  svg.absolute.transform.pointer-events-none.z-0(
    class='top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(480px,96vw)] h-[min(480px,96vw)] sm:w-[600px] sm:h-[600px]',
    viewBox='0 0 480 480',
    fill='none',
    xmlns='http://www.w3.org/2000/svg'
  )
    g(transform='rotate(-20 240 240)')
      // Top arc of the orbit line
      path(d='M 20 240 A 220 100 0 0 1 460 240', stroke='#0d9488', stroke-width='1')

      // Cube 1 — visible only on the back half of the orbit
      g.orbit-cube(opacity='0')
        path(
          d='M 0 -10 L 8.66 -5 L 8.66 5 L 0 10 L -8.66 5 L -8.66 -5 Z',
          fill='#0d9488',
          stroke='#6b7280',
          stroke-width='1',
          stroke-linejoin='round'
        )
        path(
          d='M 8.66 -5 L 0 0 L -8.66 -5 M 0 0 L 0 10',
          stroke='#6b7280',
          stroke-width='1'
        )
        animateMotion(
          dur='14s',
          repeatCount='indefinite',
          path='M 460 240 A 220 100 0 1 1 20 240 A 220 100 0 1 1 460 240'
        )
        animate(
          attributeName='opacity',
          calcMode='discrete',
          values='0;1',
          keyTimes='0;0.5',
          dur='14s',
          repeatCount='indefinite'
        )

      // Cube 2 — back half, opposite phase
      g.orbit-cube(opacity='0')
        path(
          d='M 0 -10 L 8.66 -5 L 8.66 5 L 0 10 L -8.66 5 L -8.66 -5 Z',
          fill='#0d9488',
          stroke='#6b7280',
          stroke-width='1',
          stroke-linejoin='round'
        )
        path(
          d='M 8.66 -5 L 0 0 L -8.66 -5 M 0 0 L 0 10',
          stroke='#6b7280',
          stroke-width='1'
        )
        animateMotion(
          dur='14s',
          begin='-7s',
          repeatCount='indefinite',
          path='M 460 240 A 220 100 0 1 1 20 240 A 220 100 0 1 1 460 240'
        )
        animate(
          attributeName='opacity',
          calcMode='discrete',
          values='0;1',
          keyTimes='0;0.5',
          dur='14s',
          begin='-7s',
          repeatCount='indefinite'
        )

  // Orbit — front half, drawn above the photo
  svg.absolute.transform.pointer-events-none.z-20(
    class='top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(480px,96vw)] h-[min(480px,96vw)] sm:w-[600px] sm:h-[600px]',
    viewBox='0 0 480 480',
    fill='none',
    xmlns='http://www.w3.org/2000/svg'
  )
    g(transform='rotate(-20 240 240)')
      // Bottom arc of the orbit line
      path(d='M 20 240 A 220 100 0 0 0 460 240', stroke='#0d9488', stroke-width='1')

      // Cube 1 — visible only on the front half of the orbit
      g.orbit-cube(opacity='0')
        path(
          d='M 0 -10 L 8.66 -5 L 8.66 5 L 0 10 L -8.66 5 L -8.66 -5 Z',
          fill='#0d9488',
          stroke='#6b7280',
          stroke-width='1',
          stroke-linejoin='round'
        )
        path(
          d='M 8.66 -5 L 0 0 L -8.66 -5 M 0 0 L 0 10',
          stroke='#6b7280',
          stroke-width='1'
        )
        animateMotion(
          dur='14s',
          repeatCount='indefinite',
          path='M 460 240 A 220 100 0 1 1 20 240 A 220 100 0 1 1 460 240'
        )
        animate(
          attributeName='opacity',
          calcMode='discrete',
          values='1;0',
          keyTimes='0;0.5',
          dur='14s',
          repeatCount='indefinite'
        )

      // Cube 2 — front half, opposite phase
      g.orbit-cube(opacity='0')
        path(
          d='M 0 -10 L 8.66 -5 L 8.66 5 L 0 10 L -8.66 5 L -8.66 -5 Z',
          fill='#0d9488',
          stroke='#6b7280',
          stroke-width='1',
          stroke-linejoin='round'
        )
        path(
          d='M 8.66 -5 L 0 0 L -8.66 -5 M 0 0 L 0 10',
          stroke='#6b7280',
          stroke-width='1'
        )
        animateMotion(
          dur='14s',
          begin='-7s',
          repeatCount='indefinite',
          path='M 460 240 A 220 100 0 1 1 20 240 A 220 100 0 1 1 460 240'
        )
        animate(
          attributeName='opacity',
          calcMode='discrete',
          values='1;0',
          keyTimes='0;0.5',
          dur='14s',
          begin='-7s',
          repeatCount='indefinite'
        )
