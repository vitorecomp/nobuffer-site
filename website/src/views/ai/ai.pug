#ai.relative.isolate.overflow-hidden.px-6.pt-16.pb-16(class='sm:pt-24 sm:pb-24 lg:px-0')
  .relative.mx-auto.w-full.max-w-2xl.overflow-hidden.rounded-xl.shadow-xl.ring-1(
    class='lg:mx-0 lg:ml-auto lg:max-w-none lg:w-[90vw] lg:min-h-[60vh] lg:rounded-r-none ring-gray-400/10 bg-[#14142f]'
  )
    svg.pointer-events-none.absolute.inset-0.h-full.w-full(aria-hidden='true')
      defs
        pattern#ai-diagonal-grid(
          width='36',
          height='36',
          patternUnits='userSpaceOnUse',
          patternTransform='rotate(45)'
        )
          path(
            d='M 0 0 H 36 M 0 0 V 36',
            fill='none',
            stroke='#3b3b78',
            stroke-opacity='0.35',
            stroke-width='1'
          )
      rect(width='100%', height='100%', fill='url(#ai-diagonal-grid)')
      

    .relative.grid.grid-cols-1.gap-y-2.gap-x-8(class='lg:grid-cols-12 lg:items-start lg:gap-y-10')
      .pt-12.pb-4(
        class='lg:col-span-11 lg:col-start-1 lg:row-start-1 lg:ml-[max(0px,50%_-_46rem)] lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-12 lg:gap-x-8 lg:py-16'
      )
        div(class='px-6 lg:px-0 lg:col-span-6')
          include description/description-section.pug
      .flex.justify-center.pt-10.pb-20(
        class='lg:py-12 lg:justify-start lg:sticky lg:top-4 lg:col-start-7 lg:col-span-5 lg:row-start-1'
      )
        include photo-panel/photo-panel-section.pug
