include background/background-fotter.pug

#contacts.mx-auto.max-w-7xl.px-6(class='lg:px-8')
  //- Terminal eyebrow + heading, same lockup as the hero section
  .max-w-2xl
    p.font-mono.text-base.leading-7.text-teal-600
      span.text-gray-400 ~$&nbsp;
      | cat ./contacts.txt
    h2.mt-2.font-mono.text-3xl.font-bold.tracking-tight.text-gray-900(class='sm:text-4xl')
      | Let's connect
      span.text-teal-600.animate-pulse &#9612;
    p.mt-6.font-mono.text-lg.leading-8.text-gray-700
      | Open to interesting projects, open-source collaboration, and good
      | conversations about code, hardware, and AI. Pick a channel below.

  //- Links as a terminal panel, echoing the navbar's mobile "$ ls ./links" menu
  .mt-12.rounded-lg.bg-gray-900.p-4.font-mono.text-base.shadow-lg(class='sm:p-6')
    p.px-3.pb-3.text-xs.text-gray-500 $ ls ./links
    .grid.grid-cols-2.gap-1(class='sm:grid-cols-3 lg:grid-cols-6')
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://github.com/vitorecomp',
        target='_blank',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-500 ./
        | github
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://www.linkedin.com/in/vieiravitor',
        target='_blank',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-500 ./
        | linkedin
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://www.instagram.com/vitorx86.dev/',
        target='_blank',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-500 ./
        | insta
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://blog.vitorx86.dev',
        target='_blank',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-500 ./
        | blog
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://resume.vitorx86.dev',
        target='_blank',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-500 ./
        | resume

  //- Bottom bar: copyright + terminal sign-off
  .mt-12.flex.flex-col.items-center.justify-between.gap-4.border-t.border-gray-200.pt-8(
    class='sm:flex-row'
  )
    p.font-mono.text-sm.text-gray-500 &copy; 2026 Vieira Vitor. All rights reserved.
    p.font-mono.text-sm.text-gray-400
      span ~$&nbsp;
      | exit 0
