include background/background-footer.pug

#contacts.mx-auto.max-w-7xl.px-6.pt-16(class='sm:pt-20 lg:px-8')
  //- Terminal eyebrow + heading, same lockup as the hero section
  .max-w-2xl
    p.font-mono.font-bold.text-base.leading-7.text-teal-700
      span.text-gray-500 ~$&nbsp;
      | cat ./contacts.txt
    h2.mt-2.font-mono.text-3xl.font-bold.tracking-tight.text-gray-900(class='sm:text-4xl')
      | Let's connect
      span.text-teal-600.animate-pulse(aria-hidden='true') &#9612;
    p.mt-6.font-mono.text-lg.leading-8.text-gray-700
      | Open to interesting projects, open-source collaboration, and good
      | conversations about code, hardware, and AI. Pick a channel below.

    //- Primary channel first; the panel below stays as the full listing
    .mt-8
      a.group.inline-flex.items-center.gap-3.rounded-lg.border.border-gray-700.bg-gray-900.px-5.py-3.font-mono.text-sm.text-green-400.shadow-md.transform.transition-all.duration-200(
        href='https://www.linkedin.com/in/vieiravitor',
        target='_blank', rel='noopener',
        class='sm:px-6 sm:py-4 sm:text-base hover:bg-gray-800 hover:shadow-lg hover:-translate-y-0.5'
      )
        span.text-gray-400 $
        span ./connect_linkedin.sh
        svg.h-5.w-5.text-green-400(
          class='sm:h-6 sm:w-6',
          fill='none',
          stroke='currentColor',
          stroke-width='2',
          viewBox='0 0 24 24',
          xmlns='http://www.w3.org/2000/svg',
          aria-hidden='true'
        )
          path(
            stroke-linecap='round',
            stroke-linejoin='round',
            d='M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25'
          )

  //- Links as a terminal panel, echoing the navbar's mobile "$ ls ./links" menu
  .mt-12.rounded-lg.bg-gray-900.p-4.font-mono.text-base.shadow-lg(class='sm:p-6')
    p.px-3.pb-3.text-xs.text-gray-400 $ ls ./links
    .grid.grid-cols-2.gap-1(class='sm:grid-cols-3 lg:grid-cols-5')
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://github.com/vitorecomp',
        target='_blank', rel='noopener',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-400 ./
        | github
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://www.linkedin.com/in/vieiravitor',
        target='_blank', rel='noopener',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-400 ./
        | linkedin
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://www.instagram.com/vitorx86.dev/',
        target='_blank', rel='noopener',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-400 ./
        | insta
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href='https://blog.vitorx86.dev',
        target='_blank', rel='noopener',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-400 ./
        | blog
      a.block.rounded-md.px-3.py-2.text-gray-300(
        href=require('../../assets/files/vitor-vieira-resume.pdf'),
        target='_blank', rel='noopener',
        class='hover:bg-gray-800 hover:text-green-400'
      )
        span.text-gray-400 ./
        | resume

  //- Bottom bar: copyright + terminal sign-off
  .mt-12.flex.flex-col.items-center.justify-between.gap-4.border-t.border-gray-200.pt-8(
    class='sm:flex-row'
  )
    p.font-mono.text-sm.text-gray-500 &copy; 2026 Vieira Vitor. All rights reserved.
    p.font-mono.text-sm.text-gray-500
      span ~$&nbsp;
      | exit 0
