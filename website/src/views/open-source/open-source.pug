//- Move it to a template
#open-source.relative.isolate.overflow-hidden.px-6(class='lg:px-0')
  .relative.mx-auto.w-full.max-w-2xl.rounded-xl.shadow-xl.ring-1(
    class='lg:mx-0 lg:max-w-none lg:w-[90vw] lg:min-h-[60vh] lg:rounded-l-none ring-gray-400/10 bg-gray-900/60'
  )
    //- Same two-column approach as the main section, now inside the card
    //- stacked (mobile): keep robot and description close; lg restores air
    .grid.grid-cols-1.gap-y-2.gap-x-8(class='lg:grid-cols-2 lg:items-start lg:gap-y-10')
      //- On mobile the text must come before the robot canvas (order-*);
      //- at lg the explicit col/row placement overrides order entirely
      .order-2(
        class='lg:col-span-2 lg:col-start-1 lg:row-start-1 lg:mx-auto lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-2 lg:gap-x-8 lg:px-8'
      )
        include robot-panel/robot-panel-section.pug
      .order-1.px-6.pt-2.pb-10.flex.justify-center(
        class='lg:p-12 lg:justify-start lg:sticky lg:top-4 lg:col-start-2 lg:row-span-2 lg:row-start-1'
      )
        include description/description-section.pug
