#ai-companion.relative.isolate.overflow-hidden.px-6.pt-16(class='sm:pt-24 sm:pb-24 lg:px-0')
  //- Continuation of backyard-mech's #bottom-detail: the teal band runs
  //- behind this panel and ends with the section (same geometry as the
  //- original block, so the two pieces merge into one continuous stripe)
  .pointer-events-none.absolute.inset-y-0.bg-teal-600(
    class='left-1/3 -translate-x-1/2 w-48 sm:w-80 lg:w-[30rem]',
    aria-hidden='true'
  )

  .relative.mx-auto.w-full.max-w-2xl.overflow-hidden.rounded-xl.shadow-xl.ring-1(
    class='lg:mx-auto lg:max-w-none lg:rounded-none ring-gray-400/10 bg-[#14142f]'
  )
    svg.pointer-events-none.absolute.inset-0.h-full.w-full(aria-hidden='true')
      defs
        pattern#ai-companion-mech-diagonal-grid(
          width='36',
          height='36',
          patternUnits='userSpaceOnUse',
          patternTransform='rotate(45)'
        )
          path(
            d='M 0 0 H 36 M 0 0 V 36',
            fill='none',
            stroke='#3b3b78',
            stroke-opacity='0.35',
            stroke-width='1'
          )
      rect(width='100%', height='100%', fill='url(#ai-companion-mech-diagonal-grid)')

    //- Alissa on the left, text on the right (stacked text-first on mobile)
    .relative.mx-auto.w-full.max-w-7xl.px-6(class='lg:px-8')
      .grid.grid-cols-1.gap-x-8.gap-y-12.py-16(class='sm:py-20 lg:grid-cols-2 lg:items-center')
        div(class='lg:order-2 lg:pl-4')
          include description/description-section.pug
        .flex.justify-center(class='lg:order-1 lg:justify-start lg:pl-8')
          include photo-panel/photo-panel-section.pug
