#ai-companion.relative.isolate.overflow-hidden()
  .relative.mx-auto.w-full.max-w-2xl.overflow-hidden.shadow-xl.ring-1(
    class='lg:mx-auto lg:max-w-none ring-gray-400/10 bg-[#14142f]'
  )
    svg.pointer-events-none.absolute.inset-0.h-full.w-full(aria-hidden='true')
      defs
        pattern#ai-companion-mech-diagonal-grid(
          width='36',
          height='36',
          patternUnits='userSpaceOnUse',
          patternTransform='rotate(45)'
        )
          path(
            d='M 0 0 H 36 M 0 0 V 36',
            fill='none',
            stroke='#3b3b78',
            stroke-opacity='0.35',
            stroke-width='1'
          )
      rect(width='100%', height='100%', fill='url(#ai-companion-mech-diagonal-grid)')
        .grid.grid-cols-1.gap-y-2.gap-x-8(class='lg:grid-cols-2 lg:items-start lg:gap-y-10')
          div(
            class='lg:col-span-2 lg:col-start-1 lg:row-start-1 lg:mx-auto lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-2 lg:gap-x-8 lg:px-8'
          )
            include photo-panel/photo-panel-section.pug
          .px-6.pt-2.pb-10.flex.justify-center(
            class='lg:p-12 lg:justify-start lg:sticky lg:top-4 lg:col-start-2 lg:row-span-2 lg:row-start-1'
          )
            include description/description-section.pug