//- 
svg#box-background.absolute.top-0.left-0.stroke-gray-200.-z-10.pointer-events-none(
  class='h-[300%] w-[100%]',
  aria-hidden='true'
)
  svg.overflow-visible(x='50%', y='-1')
    g#background-fills(transform='rotate(45)')
      // Filled boxes will be generated by JS


svg#planettary-background.absolute.top-0.left-0.w-full.h-full.-z-9.pointer-events-none(
  class='h-[300%] top-[40%] sm:top-[50%] lg:top-[70%]',
  aria-hidden='true'
)
  rect(
    width='500%',
    height='300%',
    stroke-width='0',
    fill='black',
    opacity='0.5',
    transform='rotate(20)'
  )

//- Atom canvas: same footprint as the planetary svg, but stacked above the
//- page content (z-20) so the atom floats over things like the robot panel
#constellation-canvas-container.absolute.top-0.left-0.w-full.h-full.z-20.pointer-events-none.overflow-hidden(
  class='h-[300%] top-[40%] sm:top-[50%] lg:top-[30%]',
  aria-hidden='true'
)

script(src=require('../../scripts/background.js'))
script(src=require('../../scripts/constellation.js'))
