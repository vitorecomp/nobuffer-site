svg#box-background.absolute.top-0.left-0.stroke-gray-200.-z-10.pointer-events-none(
  class='h-[300%] w-[100%]',
  aria-hidden='true'
)
  svg.overflow-visible(x='50%', y='-1')
    g#background-fills(transform='rotate(45)')
      // Filled boxes will be generated by JS


svg#planettary-background.absolute.top-0.left-0.w-full.h-full.-z-9.pointer-events-none(
  class='h-[300%] top-[40%] sm:top-[50%] lg:top-[30%]',
  aria-hidden='true'
)
  rect(
    width='500%',
    height='300%',
    stroke-width='0',
    fill='black',
    opacity='0.5',
    transform='rotate(30)'
  )
  foreignObject(width="100%" height="100%")
    div#constellation-canvas-container(style="width: 100%; height: 100%; overflow: hidden;")

script(src=require('../../scripts/background.js'))
script(src=require('../../scripts/constellation.js'))
