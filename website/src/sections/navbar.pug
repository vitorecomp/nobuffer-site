        .hidden(class='sm:ml-6 sm:block')
          .flex.space-x-4
            //- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white"
            a.bg-gray-900.text-white.rounded-md.px-3.py-2.text-sm.font-medium(
              href='#',
              aria-current='page'
            ) Github
            a.text-gray-900.rounded-md.px-3.py-2.text-sm.font-medium(
              href='#',
              class='hover:bg-gray-700 hover:text-white'
            ) Portfolio
            a.text-gray-900.rounded-md.px-3.py-2.text-sm.font-medium(
              href='#',
              class='hover:bg-gray-700 hover:text-white'
            ) Blog
            a.text-gray-900.rounded-md.px-3.py-2.text-sm.font-medium(
              href='#',
              class='hover:bg-gray-700 hover:text-white'
            ) Curriculum
            a.text-gray-900.rounded-md.px-3.py-2.text-sm.font-medium(
              href='#',
              class='hover:bg-gray-700 hover:text-white'
