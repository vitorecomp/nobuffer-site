              href='https://github.com/vitorecomp',
              target='_blank',
              class='hover:bg-gray-900 hover:text-green-400'
            )
              span.text-gray-400(class='group-hover:text-gray-500') ./
              | github
            a.group.rounded-md.px-3.py-2.text-gray-900.transition-colors.duration-150(
              href='https://cases.vitorx86.dev',
              target='_blank',
              class='hover:bg-gray-900 hover:text-green-400'
            )
              span.text-gray-400(class='group-hover:text-gray-500') ./
              | portfolio
            a.group.rounded-md.px-3.py-2.text-gray-900.transition-colors.duration-150(
              href='https://blog.vitorx86.dev',
              target='_blank',
              class='hover:bg-gray-900 hover:text-green-400'
            )
              span.text-gray-400(class='group-hover:text-gray-500') ./
              | blog
            a.group.rounded-md.px-3.py-2.text-gray-900.transition-colors.duration-150(
              href='https://resume.vitorx86.dev',
              target='_blank',
              class='hover:bg-gray-900 hover:text-green-400'
            )
              span.text-gray-400(class='group-hover:text-gray-500') ./
              | resume
            a.group.rounded-md.px-3.py-2.text-gray-900.transition-colors.duration-150(
              href='https://www.linkedin.com/in/vieiravitor',
              target='_blank',
              class='hover:bg-gray-900 hover:text-green-400'
