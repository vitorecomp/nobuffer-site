                              polyline(points='16,56 42,48 64,26 88,44 114,20 144,30', fill='none', stroke='#4ade80', stroke-width='2')
                              line(x1='16', y1='64', x2='144', y2='64', stroke='currentColor', stroke-width='1.25', stroke-opacity='0.5')
                              text(x='20', y='24', fill='#2dd4bf', font-size='8', font-family='monospace') CAN_BUS // 500KBPS

                        //- Right schematic spec readout + clone command
                        .flex.flex-col.justify-between.gap-3(class='sm:col-span-8')
                          .border.bg-gray-900(class='px-3.5 py-2.5 border-gray-700/80')
                            p.font-mono.text-xs.text-gray-400
                              | $ git clone
                            p.truncate.font-mono.text-xs.font-bold.text-green-400(class='mt-0.5')
                              | github.com/vitorecomp/#{project.name}.git
                          .grid.grid-cols-1.gap-2(class='sm:grid-cols-3')
                            each spec in project.specs
                              .flex.items-center.justify-between.border(
                                class='px-2.5 py-1.5 sm:block border-gray-700/70 bg-gray-900/80'
                              )
                                p.font-mono.text-gray-400(class='text-[10px] leading-tight')= spec.label
                                p.font-mono.font-bold.text-white(class='sm:mt-0.5 text-[11px]')= spec.value

                    //- Card Body (project title, description, architecture highlights, tags, dual actions)
                    .flex.flex-1.flex-col.justify-between.px-6.py-6(class='sm:px-14 sm:py-6')
                      div
                        p.font-mono.text-xs.text-gray-400
                          | ~/projects/
                          span.text-teal-300= project.name
                        h3.mt-1.font-mono.text-2xl.font-bold.tracking-tight.text-white(class='sm:text-3xl')
                          = project.title
                        p.mt-3.font-mono.text-sm.leading-7.text-gray-300(class='sm:text-base')
                          = project.desc

                        //- Architecture spec highlights from cases.vitorx86.dev
                        .mt-5.border.p-4(class='border-gray-800 bg-gray-800/40')
                          p.font-mono.text-xs.font-bold.text-teal-400
                            span.text-gray-400 ~$&nbsp;
                            | cat ./architecture.spec
                          ul.mt-2(class='space-y-1.5')
                            each item in project.highlights
                              li.flex.items-start.gap-2.font-mono.text-xs.leading-relaxed.text-gray-300
                                span.font-bold.text-teal-400(aria-hidden='true') &raquo;
                                span= item

                        +tagChips(project.tags, 'rounded-none border-teal-400/40 text-teal-300').mt-5

                      //- Dual Card Actions: Case Study on cases.vitorx86.dev + GitHub Repo
                      .mt-6.flex.flex-wrap.items-center.justify-between.gap-4.border-t.pt-5(
                        class='border-gray-800'
                      )
                        a.group.inline-flex.items-center.gap-2.border.border-gray-700.bg-gray-800.px-4.py-2.font-mono.text-xs.font-bold.text-green-400.transition-colors.duration-150(
                          href=project.caseHref,
                          target='_blank',
                          rel='noopener',
                          class='min-h-[44px] sm:text-sm hover:border-teal-400/60 hover:bg-gray-700'
                        )
                          span.text-gray-400 $
                          span ./read_case_study.sh
                          span.inline-block.transition-transform.duration-200(
                            class='group-hover:translate-x-0.5 group-hover:-translate-y-0.5'
                          ) &#8599;

                        a.group.inline-flex.items-center.px-2.py-2.font-mono.text-xs.font-bold.text-teal-300.transition-colors.duration-150(
                          href=project.href,
                          target='_blank',
                          rel='noopener',
                          class='min-h-[44px] gap-1.5 sm:text-sm hover:text-green-400'
                        )
                          span.text-gray-400 $&nbsp;
                          span ./open_repo.sh
                          span.ml-1.inline-block.transition-transform.duration-200(
                            class='group-hover:translate-x-1'
                          ) &rarr;

              //- Side < and > slider buttons on desktop (0px boxy)
              button.hidden.items-center.justify-center.border.border-gray-700.bg-gray-900.text-green-400.transition-colors.duration-150(
                type='button',
                data-portfolio-prev,
                aria-label='Previous project card',
                class='sm:flex absolute left-2.5 top-1/2 -translate-y-1/2 z-20 h-11 w-9 bg-gray-900/90 hover:border-teal-400/60 hover:bg-gray-800'
              )
                svg.h-5.w-5(fill='none', stroke='currentColor', stroke-width='2.25', viewBox='0 0 24 24', aria-hidden='true')
                  path(stroke-linecap='square', stroke-linejoin='miter', d='M15.75 19.5L8.25 12l7.5-7.5')

              button.hidden.items-center.justify-center.border.border-gray-700.bg-gray-900.text-green-400.transition-colors.duration-150(
                type='button',
                data-portfolio-next,
                aria-label='Next project card',
                class='sm:flex absolute right-2.5 top-1/2 -translate-y-1/2 z-20 h-11 w-9 bg-gray-900/90 hover:border-teal-400/60 hover:bg-gray-800'
              )
                svg.h-5.w-5(fill='none', stroke='currentColor', stroke-width='2.25', viewBox='0 0 24 24', aria-hidden='true')
                  path(stroke-linecap='square', stroke-linejoin='miter', d='M8.25 4.5l7.5 7.5-7.5 7.5')

            //- Engineering domain directories strip (from cases.vitorx86.dev)
            .grid.grid-cols-2.gap-2.border-t.px-4.py-3(
              class='sm:grid-cols-4 sm:px-6 border-gray-800 bg-gray-900/90'
            )
              a.group.flex.items-center.justify-between.border.font-mono.text-xs.text-gray-300.transition-colors.duration-150(
                href='https://cases.vitorx86.dev/systems',
                target='_blank',
                rel='noopener',
                class='min-h-[44px] px-2.5 py-1.5 border-gray-800 bg-gray-800/50 hover:border-teal-400/50 hover:text-teal-300'
              )
                span.truncate ~/systems
                span.ml-1.text-teal-400 [7]
              a.group.flex.items-center.justify-between.border.font-mono.text-xs.text-gray-300.transition-colors.duration-150(
                href='https://cases.vitorx86.dev/ai',
                target='_blank',
                rel='noopener',
                class='min-h-[44px] px-2.5 py-1.5 border-gray-800 bg-gray-800/50 hover:border-teal-400/50 hover:text-teal-300'
              )
                span.truncate ~/ai-mcp
                span.ml-1.text-teal-400 [8]
              a.group.flex.items-center.justify-between.border.font-mono.text-xs.text-gray-300.transition-colors.duration-150(
                href='https://cases.vitorx86.dev/hardware',
                target='_blank',
                rel='noopener',
                class='min-h-[44px] px-2.5 py-1.5 border-gray-800 bg-gray-800/50 hover:border-teal-400/50 hover:text-teal-300'
              )
                span.truncate ~/mech
                span.ml-1.text-teal-400 [6]
              a.group.flex.items-center.justify-between.border.font-mono.text-xs.text-gray-300.transition-colors.duration-150(
                href='https://cases.vitorx86.dev/cloud-devtools',
                target='_blank',
                rel='noopener',
                class='min-h-[44px] px-2.5 py-1.5 border-gray-800 bg-gray-800/50 hover:border-teal-400/50 hover:text-teal-300'
              )
                span.truncate ~/cloud
                span.ml-1.text-teal-400 [13]

            //- Carousel bottom bar: mobile prev/next + centered pagination blocks
            .flex.items-center.justify-between.gap-3.border-t.px-4(
              class='py-2.5 border-gray-700/60 bg-gray-800/60 sm:justify-center'
            )
              button.inline-flex.items-center.justify-center.border.border-gray-700.bg-gray-900.px-3.font-mono.text-xs.text-green-400.transition-colors.duration-150(
                type='button',
                data-portfolio-prev,
                aria-label='Show previous portfolio project',
                class='min-h-[44px] min-w-[44px] sm:hidden hover:bg-gray-800'
              )
                svg.h-4.w-4(fill='none', stroke='currentColor', stroke-width='2.25', viewBox='0 0 24 24', aria-hidden='true')
                  path(stroke-linecap='square', stroke-linejoin='miter', d='M15.75 19.5L8.25 12l7.5-7.5')

              //- Interactive pagination blocks (0px boxy)
              .flex.flex-wrap.items-center.justify-center.gap-1(role='tablist', aria-label='Select project slide')
                each project, idx in projects
                  button.group.inline-flex.items-center.justify-center.px-1(
                    type='button',
                    data-portfolio-dot=idx,
                    aria-label=`Project ${idx + 1}: ${project.title}`,
                    aria-current=idx === 0 ? 'true' : null,
                    class='min-h-[44px] min-w-[28px]'
                  )
                    span.transition-all.duration-200(
                      data-dot-pill,
                      class=idx === 0 ? 'h-2.5 w-7 bg-teal-400' : 'h-2.5 w-2.5 bg-gray-600 group-hover:bg-gray-400'
                    )

              button.inline-flex.items-center.justify-center.border.border-gray-700.bg-gray-900.px-3.font-mono.text-xs.text-green-400.transition-colors.duration-150(
                type='button',
                data-portfolio-next,
                aria-label='Show next portfolio project',
                class='min-h-[44px] min-w-[44px] sm:hidden hover:bg-gray-800'
              )
                svg.h-4.w-4(fill='none', stroke='currentColor', stroke-width='2.25', viewBox='0 0 24 24', aria-hidden='true')
                  path(stroke-linecap='square', stroke-linejoin='miter', d='M8.25 4.5l7.5 7.5-7.5 7.5')

          //- ================================================================
          //- RIGHT 40% (lg:col-span-2): INDUSTRIAL DATASHEET BLOG SIDEBAR
          //- (Based on personal-blog's ARC P1 Engineering Datasheet right rail)
          //- ================================================================
          aside.grid.overflow-hidden.border.shadow-xl(
            class='lg:col-span-2 grid-cols-[2.5rem_minmax(0,1fr)] border-[#18181b] bg-[#f4f4f1] text-[#141414]',
            aria-label='Recent blog articles from blog.vitorx86.dev'
          )
            //- Left Signal-Orange Spine (#ff4814)
            .flex.select-none.flex-col.items-center.justify-between.border-r.py-3(
              class='border-[#18181b] bg-[#ff4814] text-[#141414]',
              aria-hidden='true'
            )
              span.px-1.text-center.font-mono.font-extrabold.leading-tight(class='text-[10px]')
                | 001
                br
                | v01
              span.whitespace-nowrap.font-mono.text-xs.font-extrabold.uppercase.tracking-widest(
                style='writing-mode: vertical-rl; transform: rotate(180deg);'
              ) ENGINEERING LOG // BLOG
              span.font-mono.text-base.font-extrabold.leading-none &#8599;

            //- Right Main Datasheet Column
            .flex.min-w-0.flex-col
              //- Datasheet Top Spec Bar
              .flex.items-center.justify-between.gap-2.border-b.px-4.py-2.font-mono.font-bold.uppercase.tracking-wider(
                class='border-[#18181b] bg-[#e2e3df] text-[10px] text-[#18181b]'
              )
                span V86 / SYSTEMS FOR PRODUCTION
                span SERIAL NO. 001

              //- Datasheet Hero / Publication Block
              .border-b.px-5.py-4(class='border-[#18181b]')
                .flex.items-center.justify-between.gap-2
                  span.font-mono.font-bold.uppercase.tracking-wider(class='text-[10px] text-[#3f3f46]')
                    | BLOG.VITORX86.DEV // RECENT ARTICLES
                  span.border.font-mono.font-bold.uppercase(
                    class='px-1.5 py-0.5 border-[#18181b] bg-[#ff4814] text-[10px] text-[#141414]'
                  ) LIVE FEED
                h3.font-mono.text-xl.font-extrabold.tracking-tight(class='mt-1.5 text-[#141414] sm:text-2xl')
                  | vitorx86.dev&reg;
                  br
                  | Engineering Blog
                p.mt-2.font-mono.text-xs.leading-relaxed(class='text-[#27272a]')
                  | Adaptive systems engineering log by Vitor Vieira (@vitorecomp) &mdash;
                  | low-level Rust, Go, C++, MCP agents, and embedded garage robotics.

              //- Stacked Recent Articles Datasheet Rows
              .flex.flex-1.flex-col.divide-y(class='divide-[#18181b]')
                each article, aIdx in blogArticles
                  article.flex.flex-1.flex-col.justify-between.px-5.transition-colors.duration-150(
                    class='py-3.5 hover:bg-[#e8e8e3]'
                  )
                    div
                      .flex.items-center.justify-between.gap-2.font-mono(class='text-[11px]')
                        .flex.items-center(class='gap-1.5')
                          span.border.font-bold(
                            class='px-1.5 py-0.5 border-[#18181b] bg-[#141414] text-[10px] text-[#f4f4f1]'
                          ) 0#{aIdx + 1}
                          span.font-bold(class='text-[#141414]')= article.channel
                        span.font-semibold.uppercase(class='text-[#3f3f46]')= article.readTime
                      h4.mt-2.font-mono.text-sm.font-extrabold.leading-snug(class='text-[#141414] sm:text-base')
                        a.transition-colors.duration-150(
                          href=article.href,
                          target='_blank',
                          rel='noopener',
                          class='hover:text-[#c23008] hover:underline'
                        )= article.title
                      p.font-mono.text-xs.leading-relaxed(class='mt-1.5 text-[#27272a]')
                        = article.excerpt
                    .mt-2.flex.items-center.justify-between.border-t.pt-2(class='border-[#18181b]/20')
                      span.font-mono.uppercase.tracking-wider(class='text-[10px] text-[#3f3f46]')
                        | SPEC // ARTICLE_0#{aIdx + 1}
                      a.group.inline-flex.items-center.gap-1.font-mono.text-xs.font-extrabold.uppercase.tracking-wider.transition-colors.duration-150(
                        href=article.href,
                        target='_blank',
                        rel='noopener',
                        class='min-h-[44px] text-[#141414] hover:text-[#c23008]'
                      )
                        span READ DISPATCH
                        span.inline-block.transition-transform.duration-200(
                          class='group-hover:translate-x-0.5 group-hover:-translate-y-0.5'
                        ) &#8599;

              //- Datasheet Spec Header Strip
              .flex.items-center.justify-between.gap-2.border-t.px-4.font-mono.font-bold.uppercase.tracking-wider(
                class='py-1.5 border-[#18181b] bg-[#141414] text-[10px] text-[#f4f4f1]'
              )
                span CHANNEL: BLOG.VITORX86.DEV
                span OUTPUT: CONTINUOUS DUTY

              //- Split Action Footer Cells (Open Blog + RSS)
              .grid.grid-cols-2.divide-x.border-t(class='divide-[#18181b] border-[#18181b] bg-[#e2e3df]')
                a.group.flex.flex-col.justify-between.px-4.transition-colors.duration-150(
                  href='https://blog.vitorx86.dev',
                  target='_blank',
                  rel='noopener',
                  class='py-2.5 min-h-[44px] hover:bg-[#ff4814]'
                )
                  span.font-mono.font-bold.uppercase.tracking-wider(class='text-[9px] text-[#3f3f46] group-hover:text-[#141414]')
                    | PUBLICATION
                  .flex.items-center.justify-between.font-mono.text-xs.font-extrabold(class='mt-0.5 text-[#141414]')
                    span OPEN BLOG
                    span &#8599;

                a.group.flex.flex-col.justify-between.px-4.transition-colors.duration-150(
                  href='https://blog.vitorx86.dev/rss/',
                  target='_blank',
                  rel='noopener',
                  class='py-2.5 min-h-[44px] hover:bg-[#ff4814]'
                )
                  span.font-mono.font-bold.uppercase.tracking-wider(class='text-[9px] text-[#3f3f46] group-hover:text-[#141414]')
                    | SYNDICATION
                  .flex.items-center.justify-between.font-mono.text-xs.font-extrabold(class='mt-0.5 text-[#141414]')
                    span RSS.XML
                    span &#8599;

script(src=require('../../scripts/portfolio-carousel.js'))
